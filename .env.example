# ==========================================
# Configurações do Servidor
# ==========================================
PORT=3000
NODE_ENV=production
APP_URL=https://sua-plataforma.com
JWT_SECRET=sua_chave_jwt_ultra_secreta_com_pelo_menos_32_caracteres

# ==========================================
# Bancos de Dados
# ==========================================
DATABASE_URL=postgresql://postgres:tangpix_secure_pass_2026@tangpix_tangpix-postgres:5432/tangpix
REDIS_URL=redis://:tangpix_redis_pass_2026@tangpix_tangpix-redis:6379

# ==========================================
# Provedor de Pagamento PIX
# Opções: 'mock' (testes locais), 'efi' (Gerencianet), 'asaas', 'mercadopago'
# ==========================================
PIX_PROVIDER=mock

# Credenciais Efí (Gerencianet)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_BASE64=
EFI_PIX_KEY=

# Credenciais Asaas
ASAAS_API_KEY=
ASAAS_WALLET_ID=

# Credenciais Mercado Pago
MP_ACCESS_TOKEN=

# ==========================================
# Motor de Síntese de Voz (TTS)
# Opções:
#   'edge'       -> Microsoft Edge Neural (100% GRATUITO, sem limites de cartão)
#   'elevenlabs' -> ElevenLabs Premium (requer API Key)
#   'selfhosted' -> Servidor Local GPU (Kokoro / StyleTTS2 / XTTS)
# ==========================================
DEFAULT_TTS_PROVIDER=edge

# ElevenLabs (Opcional para contas VIP)
ELEVENLABS_API_KEY=

# Servidor Local GPU (Opcional para instâncias dedicadas)
SELF_HOSTED_TTS_URL=http://localhost:8000/tts

# ==========================================
# Regras de Negócio e Taxas
# ==========================================
PLATFORM_FEE_PERCENTAGE=5.0
MINIMUM_DONATION_CENTS=100
